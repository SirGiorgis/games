	_add("N", ["10001", "11001", "10101", "10011", "10001", "10001", "10001"])
	_add("O", ["01110", "10001", "10001", "10001", "10001", "10001", "01110"])
	_add("P", ["11110", "10001", "10001", "11110", "10000", "10000", "10000"])
	_add("Q", ["01110", "10001", "10001", "10001", "10101", "10010", "01101"])
	_add("R", ["11110", "10001", "10001", "11110", "10100", "10010", "10001"])
	_add("S", ["01111", "10000", "10000", "01110", "00001", "00001", "11110"])
	_add("T", ["11111", "00100", "00100", "00100", "00100", "00100", "00100"])
	_add("U", ["10001", "10001", "10001", "10001", "10001", "10001", "01110"])
	_add("V", ["10001", "10001", "10001", "10001", "10001", "01010", "00100"])
	_add("W", ["10001", "10001", "10001", "10101", "10101", "10101", "01010"])
	_add("X", ["10001", "10001", "01010", "00100", "01010", "10001", "10001"])
	_add("Y", ["10001", "10001", "01010", "00100", "00100", "00100", "00100"])
	_add("Z", ["11111", "00001", "00010", "00100", "01000", "10000", "11111"])
	_add("0", ["01110", "10001", "10011", "10101", "11001", "10001", "01110"])
	_add("1", ["00100", "01100", "00100", "00100", "00100", "00100", "01110"])
	_add("2", ["01110", "10001", "00001", "00010", "00100", "01000", "11111"])
	_add("3", ["11110", "00001", "00001", "01110", "00001", "00001", "11110"])
	_add("4", ["00010", "00110", "01010", "10010", "11111", "00010", "00010"])
	_add("5", ["11111", "10000", "11110", "00001", "00001", "10001", "01110"])
	_add("6", ["01110", "10000", "11110", "10001", "10001", "10001", "01110"])
	_add("7", ["11111", "00001", "00010", "00100", "01000", "01000", "01000"])
	_add("8", ["01110", "10001", "10001", "01110", "10001", "10001", "01110"])
	_add("9", ["01110", "10001", "10001", "01111", "00001", "00001", "01110"])
	_add(".", ["00000", "00000", "00000", "00000", "00000", "00100", "00100"])
	_add(",", ["00000", "00000", "00000", "00000", "00100", "00100", "01000"])
	_add("!", ["00100", "00100", "00100", "00100", "00100", "00000", "00100"])
	_add("?", ["01110", "10001", "00001", "00010", "00100", "00000", "00100"])
	_add("-", ["00000", "00000", "00000", "11111", "00000", "00000", "00000"])
	_add(":", ["00000", "00100", "00100", "00000", "00100", "00100", "00000"])
	_add("/", ["00001", "00010", "00010", "00100", "01000", "01000", "10000"])
	_add("%", ["11001", "11010", "00010", "00100", "01000", "01011", "10011"])
	_add("+", ["00000", "00100", "00100", "11111", "00100", "00100", "00000"])
	_add("'", ["00100", "00100", "01000", "00000", "00000", "00000", "00000"])
	_add("(", ["00010", "00100", "01000", "01000", "01000", "00100", "00010"])
	_add(")", ["01000", "00100", "00010", "00010", "00010", "00100", "01000"])
	_add("<", ["00001", "00010", "00100", "01000", "00100", "00010", "00001"])
	_add(">", ["10000", "01000", "00100", "00010", "00100", "01000", "10000"])
	_add("=", ["00000", "00000", "11111", "00000", "11111", "00000", "00000"])
	_add("_", ["00000", "00000", "00000", "00000", "00000", "00000", "11111"])
	_add("*", ["00000", "10001", "01010", "00100", "01010", "10001", "00000"])
	_add("x", ["00000", "10001", "01010", "00100", "01010", "10001", "00000"])


static func _add(ch: String, rows: Array) -> void:
	_glyphs[ch] = rows


static func make(text: String, color: Color, scale: int = 2, wrap: int = 0) -> ImageTexture:
	_ensure()
	var lines := _wrap(text.to_upper(), wrap)
	var maxw := 1
	for line in lines:
		maxw = maxi(maxw, line.length())
	var w := maxi(1, maxw * (GW + 1) - 1)
	var h := maxi(1, lines.size() * (GH + 1) - 1)
	var img := Pix.image(w, h)
	for li in lines.size():
		var line: String = lines[li]
		for ci in line.length():
			_blit(img, line[ci], ci * (GW + 1), li * (GH + 1), color)
	return Pix.scaled_tex(img, scale)


static func _blit(img: Image, ch: String, x: int, y: int, color: Color) -> void:
	var rows: Array = _glyphs.get(ch, _glyphs["?"])
	for yy in rows.size():
		var row: String = rows[yy]
		for xx in row.length():
			if row[xx] == "1":
				Pix.put(img, x + xx, y + yy, color)


static func _wrap(text: String, wrap: int) -> PackedStringArray:
	var out := PackedStringArray()
	if wrap <= 0:
		for raw in text.split("\n"):
			out.append(raw)
		if out.is_empty():
			out.append("")
		return out
	for raw in text.split("\n"):
		var words := raw.split(" ", false)
		var cur := ""
		for w in words:
			var trial := w if cur.is_empty() else cur + " " + w
			if trial.length() > wrap and not cur.is_empty():
				out.append(cur)
				cur = w
			else:
				cur = trial
		out.append(cur)
	return out
