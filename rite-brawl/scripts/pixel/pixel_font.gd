class_name PixelFont
extends RefCounted

const GW := 5
const GH := 7

static var _glyphs: Dictionary = {}


static func _ensure() -> void:
	if not _glyphs.is_empty():
		return
	_add(" ", ["00000", "00000", "00000", "00000", "00000", "00000", "00000"])
	_add("A", ["01110", "10001", "10001", "11111", "10001", "10001", "10001"])
	_add("B", ["11110", "10001", "10001", "11110", "10001", "10001", "11110"])
	_add("C", ["01110", "10001", "10000", "10000", "10000", "10001", "01110"])
	_add("D", ["11110", "10001", "10001", "10001", "10001", "10001", "11110"])
	_add("E", ["11111", "10000", "10000", "11110", "10000", "10000", "11111"])
	_add("F", ["11111", "10000", "10000", "11110", "10000", "10000", "10000"])
	_add("G", ["01110", "10001", "10000", "10111", "10001", "10001", "01110"])
	_add("H", ["10001", "10001", "10001", "11111", "10001", "10001", "10001"])
	_add("I", ["11111", "00100", "00100", "00100", "00100", "00100", "11111"])
	_add("J", ["00111", "00010", "00010", "00010", "00010", "10010", "01100"])
	_add("K", ["10001", "10010", "10100", "11000", "10100", "10010", "10001"])
